---
import Base from './Base.astro';
import ParticleWave from '../components/ParticleWave.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { routes } from '../data/nav.js';

interface Study {
  title: string;
  brandmark: string;
  eyebrow: string;
  headline: string;
  headlineMax: string;
  video: string | null;
  intro: string[];
  needLead: string;
  needs: string[];
  whyBrandmark: string;
  why: string[];
  quote: string;
  quoteBy: string;
  solutionTheme: 'light' | 'dark';
  solution: { img: string; alt: string; bar: string; num: string; title: string; copy: string; imgOrder: number }[];
  resultLead: string;
  resultNote: string;
}
const { study } = Astro.props as { study: Study };
const POSTER = '/assets/photos/broadcast-still.web.jpg';
---
<Base title={study.title}>
  <div class="cs">
    <!-- Hero video (poster-only when the clip is unavailable) -->
    <header class="cs-hero">
      <video
        id="cs-hero-video"
        playsinline
        preload="none"
        poster={POSTER}
        data-src={study.video ?? ''}
        class="cs-hero-video"
      ></video>
      {study.video && (
        <div class="cs-hero-controls">
          <button id="cs-play" type="button" aria-label="Play or pause the video" class="cs-ctrl"></button>
          <button id="cs-mute" type="button" aria-label="Mute or unmute the video" class="cs-ctrl"></button>
        </div>
      )}
      <div class="cs-hero-scrim" aria-hidden="true"></div>
    </header>

    <!-- Logo / eyebrow / headline -->
    <div class="cs-lede">
      <div class="cs-wave cs-wave-tr" aria-hidden="true"><ParticleWave /></div>
      <div class="cs-lede-inner">
        <img src={study.brandmark} alt={study.eyebrow} class="cs-brandmark" />
        <span class="cs-eyebrow">{study.eyebrow}</span>
        <h1 class="cs-h1" style={`max-width:${study.headlineMax};`}>{study.headline}</h1>
      </div>
    </div>

    <!-- Intro -->
    <div class="cs-intro">
      <div class="cs-intro-inner">
        {study.intro.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <!-- What they needed -->
    <div class="cs-needed">
      <div class="cs-wave cs-wave-bl" aria-hidden="true"><ParticleWave /></div>
      <div class="cs-needed-inner">
        <h2 class="cs-h2">What they needed</h2>
        <p class="cs-needed-lead">{study.needLead}</p>
        <div class="cs-needed-grid">
          {study.needs.map((n, i) => (
            <div class="cs-need-card">
              <span class="cs-need-num">{String(i + 1).padStart(2, '0')}</span>
              <p>{n}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Why BoltOS -->
    <div class="cs-why">
      <div class="cs-wave cs-wave-tr2" aria-hidden="true"><ParticleWave /></div>
      <div class="cs-why-inner">
        <div class="cs-why-copy">
          <div class="cs-why-logos">
            <img src="/assets/logos/boltos-app.webp" alt="BoltOS" class="cs-why-logo cover" />
            <span class="cs-why-x">&times;</span>
            <img src={study.whyBrandmark} alt={study.eyebrow} class="cs-why-logo contain" />
          </div>
          <h2 class="cs-h2 ink">Why BoltOS?</h2>
          {study.why.map((p) => <p>{p}</p>)}
        </div>
        <figure class="cs-quote">
          <span class="cs-quote-rule"></span>
          <blockquote>{study.quote}</blockquote>
          <figcaption>{study.quoteBy}</figcaption>
        </figure>
      </div>
    </div>

    <!-- The BoltOS Solution -->
    <div class="cs-solution">
      <div class="cs-solution-inner">
        <h2 class="cs-h2 ink">The BoltOS Solution</h2>
        <div class="cs-solution-rows">
          {study.solution.map((row) => (
            <div class="cs-sol-row">
              <div class="cs-sol-media" style={`order:${row.imgOrder};`}>
                <img src={row.img} alt={row.alt} />
              </div>
              <div class={`cs-sol-text ${study.solutionTheme}`} style={`order:${row.imgOrder === 1 ? 2 : 1}; --hover:${row.bar};`}>
                <span class="cs-sol-bar" style={`background:${row.bar};`}></span>
                <span class="cs-sol-num" style={`color:${row.bar};`}>{row.num}</span>
                <h3>{row.title}</h3>
                <p>{row.copy}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Result -->
    <div class="cs-result">
      <div class="cs-result-glow" aria-hidden="true"></div>
      <div class="cs-wave cs-wave-bl2" aria-hidden="true"><ParticleWave /></div>
      <div class="cs-result-inner">
        <div class="cs-result-head">
          <span class="cs-result-rule"></span>
          <h2 class="cs-result-title">Result</h2>
        </div>
        <div class="cs-result-body">
          <p class="cs-result-lead">{study.resultLead}</p>
          <div class="cs-result-note">
            <span class="cs-result-note-rule"></span>
            <p>{study.resultNote}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Closing CTA (standardized) -->
    <ClosingCTA />
  </div>
</Base>

<style>
  .cs { position: relative; overflow-x: hidden; }
  .cs :global(a) { color: var(--text-lilac); }
  .cs :global(a:hover) { color: var(--snow); }

  .cs-h2 { margin: 0; font-family: var(--font-display); font-size: clamp(26px, 3.2vw, 42px); line-height: 1.08; font-weight: 800; letter-spacing: -0.03em; }
  .cs-h2.ink { color: var(--ink); }

  .cs-wave { position: absolute; z-index: 0; pointer-events: none; mask-image: radial-gradient(closest-side, #000, transparent); -webkit-mask-image: radial-gradient(closest-side, #000, transparent); }
  .cs-wave-tr { right: -12%; top: -8%; width: min(48vw, 540px); height: min(28vw, 300px); opacity: 0.26; }
  .cs-wave-bl { left: -12%; bottom: -30%; width: min(50vw, 560px); height: min(28vw, 310px); opacity: 0.24; }
  .cs-wave-tr2 { right: -12%; top: -26%; width: min(48vw, 540px); height: min(28vw, 300px); opacity: 0.24; }
  .cs-wave-bl2 { left: -10%; bottom: -30%; width: min(48vw, 540px); height: min(28vw, 300px); opacity: 0.26; }

  .cs-hero { position: relative; overflow: hidden; z-index: 10; height: clamp(520px, 92vh, 1100px); }
  .cs-hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .cs-hero-controls { position: absolute; right: clamp(16px, 3vw, 32px); top: clamp(80px, 10vw, 120px); z-index: 6; display: flex; gap: 10px; }
  .cs-ctrl { width: 40px; height: 40px; border: 1px solid rgba(247,247,245,0.28); border-radius: 50%; background: rgba(16,16,20,0.6); backdrop-filter: blur(8px); color: var(--snow); font-size: 14px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0; }
  .cs-ctrl:hover { background: var(--ultra-violet); border-color: var(--ultra-violet); }
  .cs-hero-scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(180deg, rgba(11,11,15,0.26) 0%, rgba(11,11,15,0) 22%, rgba(11,11,15,0) 62%, rgba(14,14,18,0.72) 88%, #0E0E12 100%); }

  .cs-lede { position: relative; z-index: 12; overflow: hidden; margin-top: clamp(-200px, -18vh, -90px); padding: 0 var(--edge) clamp(52px, 6.4vw, 100px); }
  .cs-lede-inner { position: relative; z-index: 2; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 24px; }
  .cs-brandmark { width: 84px; height: 84px; border-radius: 18px; object-fit: contain; background: var(--snow); padding: 8px; box-sizing: border-box; display: block; }
  .cs-eyebrow { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-lilac); }
  .cs-h1 { margin: 0; font-family: var(--font-display); font-size: clamp(32px, 4.8vw, 64px); line-height: 1.02; font-weight: 800; letter-spacing: -0.036em; text-wrap: pretty; }

  .cs-intro { position: relative; overflow: hidden; padding: 0 var(--edge) clamp(52px, 6.4vw, 96px); }
  .cs-intro-inner { position: relative; z-index: 2; max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; gap: 22px; font-size: 17px; line-height: 29px; color: var(--text-muted); }
  .cs-intro-inner p { margin: 0; text-wrap: pretty; }

  .cs-needed { position: relative; overflow: hidden; background: linear-gradient(160deg, #191228, #141019 62%, #12131A); padding: clamp(52px, 6.4vw, 96px) var(--edge); border-top: 1px solid rgba(123,47,226,0.28); border-bottom: 1px solid rgba(123,47,226,0.28); }
  .cs-needed-inner { position: relative; z-index: 2; max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: clamp(24px, 3vw, 40px); }
  .cs-needed-lead { margin: 0; font-size: 17px; line-height: 29px; color: var(--text-muted); max-width: 70ch; text-wrap: pretty; }
  .cs-needed-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: clamp(14px, 1.8vw, 20px); align-items: stretch; }
  .cs-need-card { position: relative; background: rgba(247,247,245,0.045); border: 1px solid rgba(198,171,245,0.22); border-radius: 18px; padding: clamp(22px, 2.4vw, 32px); display: flex; flex-direction: column; gap: 14px; }
  .cs-need-card:hover { border-color: rgba(123,47,226,0.55); }
  .cs-need-num { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; color: var(--text-lilac); }
  .cs-need-card p { margin: 0; font-family: var(--font-display); font-size: clamp(16px, 1.8vw, 19px); line-height: 1.32; font-weight: 700; letter-spacing: -0.016em; color: var(--snow); text-wrap: pretty; }

  .cs-why { position: relative; overflow: hidden; background: var(--snow); color: var(--ink); padding: clamp(52px, 6.4vw, 96px) var(--edge); }
  .cs-why-inner { position: relative; z-index: 2; max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: clamp(28px, 3.6vw, 56px); align-items: start; }
  .cs-why-copy { min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .cs-why-copy p { margin: 0; font-size: 17px; line-height: 29px; color: var(--ink-2); text-wrap: pretty; }
  .cs-why-logos { display: flex; align-items: center; gap: 16px; }
  .cs-why-logo { width: 64px; height: 64px; border-radius: 16px; display: block; }
  .cs-why-logo.cover { object-fit: cover; }
  .cs-why-logo.contain { object-fit: contain; background: var(--snow); padding: 6px; box-sizing: border-box; }
  .cs-why-x { font-size: 18px; color: #9A958C; }
  .cs-quote { margin: 0; min-width: 0; background: var(--night); color: var(--snow); border-radius: 22px; padding: clamp(28px, 3.2vw, 44px); display: flex; flex-direction: column; gap: 20px; }
  .cs-quote-rule { width: 44px; height: 3px; border-radius: 3px; background: var(--ultra-violet); }
  .cs-quote blockquote { margin: 0; font-family: var(--font-display); font-size: clamp(19px, 2.2vw, 26px); line-height: 1.34; font-weight: 700; letter-spacing: -0.022em; text-wrap: pretty; }
  .cs-quote figcaption { font-size: 14px; line-height: 22px; color: var(--text-muted); }

  .cs-solution { position: relative; overflow: hidden; background: var(--snow-2); color: var(--ink); padding: clamp(52px, 6.4vw, 96px) var(--edge); }
  .cs-solution-inner { position: relative; z-index: 2; max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: clamp(24px, 3vw, 40px); }
  .cs-solution-rows { display: flex; flex-direction: column; gap: clamp(16px, 2vw, 28px); }
  .cs-sol-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: clamp(16px, 2.4vw, 32px); align-items: stretch; }
  .cs-sol-media { position: relative; min-width: 0; min-height: clamp(220px, 24vw, 340px); border-radius: 18px; overflow: hidden; }
  .cs-sol-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .cs-sol-text { position: relative; min-width: 0; border-radius: 18px; padding: clamp(26px, 3vw, 44px); display: flex; flex-direction: column; justify-content: center; gap: 16px; overflow: hidden; }
  .cs-sol-text.light { background: #FFFFFF; border: 1px solid var(--snow-line-3); }
  .cs-sol-text.dark { background: var(--night-2); border: 1px solid var(--hairline); }
  .cs-sol-text.dark:hover { border-color: var(--hover); }
  .cs-sol-bar { position: absolute; left: 0; top: 0; right: 0; height: 3px; }
  .cs-sol-num { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; }
  .cs-sol-text h3 { margin: 0; font-family: var(--font-display); font-size: clamp(21px, 2.4vw, 30px); line-height: 1.14; font-weight: 800; letter-spacing: -0.024em; text-wrap: pretty; }
  .cs-sol-text.light h3 { color: var(--ink); }
  .cs-sol-text.dark h3 { color: var(--snow); }
  .cs-sol-text p { margin: 0; font-size: 16px; line-height: 27px; text-wrap: pretty; }
  .cs-sol-text.light p { color: var(--ink-2); }
  .cs-sol-text.dark p { color: var(--text-muted); }

  .cs-result { position: relative; overflow: hidden; padding: clamp(56px, 7vw, 110px) var(--edge); border-top: 1px solid var(--hairline); }
  .cs-result-glow { position: absolute; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(820px 420px at 78% 20%, rgba(123,47,226,0.20), transparent 72%); }
  .cs-result-inner { position: relative; z-index: 2; max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: clamp(28px, 4vw, 72px); align-items: start; }
  .cs-result-head { min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .cs-result-rule { width: 56px; height: 3px; border-radius: 3px; background: linear-gradient(90deg, #7B2FE2, #35C7DF); }
  .cs-result-title { margin: 0; font-family: var(--font-display); font-size: clamp(34px, 4.6vw, 64px); line-height: 1.0; font-weight: 800; letter-spacing: -0.036em; color: var(--snow); }
  .cs-result-body { min-width: 0; grid-column: span 2; display: flex; flex-direction: column; gap: 26px; }
  .cs-result-lead { margin: 0; font-family: var(--font-display); font-size: clamp(22px, 2.9vw, 38px); line-height: 1.22; font-weight: 700; letter-spacing: -0.026em; color: var(--snow); text-wrap: pretty; }
  .cs-result-note { display: flex; gap: 18px; align-items: flex-start; }
  .cs-result-note-rule { flex: 0 0 auto; width: 2px; align-self: stretch; background: var(--ultra-violet); }
  .cs-result-note p { margin: 0; font-size: 17px; line-height: 29px; color: var(--text-muted); max-width: 56ch; text-wrap: pretty; }

  .cs-cta { position: relative; overflow: hidden; padding: clamp(48px, 6vw, 88px) var(--edge) clamp(60px, 7vw, 110px); border-top: 1px solid var(--hairline); }
  .cs-cta-glow { position: absolute; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(760px 380px at 50% 100%, rgba(123,47,226,0.18), transparent 74%); }
  .cs-cta-inner { position: relative; z-index: 2; max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .cs-cta-inner h2 { margin: 0; font-family: var(--font-display); font-size: clamp(30px, 4vw, 54px); line-height: 1.04; font-weight: 800; letter-spacing: -0.034em; }
  .cs-cta-btn { font-size: 16px; line-height: 24px; font-weight: 600; color: var(--ink) !important; background: var(--snow); padding: 15px 32px; border-radius: 10px; }
  .cs-cta-btn:hover { color: var(--snow) !important; background: var(--ultra-violet); }

  @media (max-width: 900px) {
    .cs-result-body { grid-column: auto; }
  }
</style>

<script>
  // Hero video: lazy-load on view, muted autoplay loop, manual play/mute controls.
  const el = document.getElementById('cs-hero-video') as HTMLVideoElement | null;
  if (el && el.dataset.src) {
    el.muted = true; el.loop = true; el.playsInline = true;
    let loaded = false, userPaused = false;
    const load = () => {
      if (loaded) return; loaded = true;
      const src = document.createElement('source');
      src.src = el.dataset.src!; src.type = 'video/mp4';
      el.appendChild(src); el.load();
    };
    const play = document.getElementById('cs-play');
    const mute = document.getElementById('cs-mute');
    const sync = () => {
      if (play) play.innerHTML = el.paused
        ? '<svg width="15" height="15" viewBox="0 0 24 24" fill="#F7F7F5" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>'
        : '<svg width="15" height="15" viewBox="0 0 24 24" fill="#F7F7F5" aria-hidden="true"><path d="M7 5h3.2v14H7zM13.8 5H17v14h-3.2z"></path></svg>';
      if (mute) mute.innerHTML = el.muted
        ? '<svg width="15" height="15" viewBox="0 0 24 24" fill="#F7F7F5" aria-hidden="true"><path d="M4 9.5h3.2L12 5.6v12.8L7.2 14.5H4z"></path><path d="M15.6 9.6l4.8 4.8M20.4 9.6l-4.8 4.8" fill="none" stroke="#F7F7F5" stroke-width="1.8" stroke-linecap="round"></path></svg>'
        : '<svg width="15" height="15" viewBox="0 0 24 24" fill="#F7F7F5" aria-hidden="true"><path d="M4 9.5h3.2L12 5.6v12.8L7.2 14.5H4z"></path><path d="M15.4 8.4a5 5 0 0 1 0 7.2" fill="none" stroke="#F7F7F5" stroke-width="1.8" stroke-linecap="round"></path><path d="M17.9 6a8.3 8.3 0 0 1 0 12" fill="none" stroke="#F7F7F5" stroke-width="1.8" stroke-linecap="round"></path></svg>';
    };
    if (play) play.addEventListener('click', () => {
      load();
      if (el.paused) { userPaused = false; el.play().catch(() => {}); }
      else { userPaused = true; el.pause(); }
      setTimeout(sync, 60);
    });
    if (mute) mute.addEventListener('click', () => { el.muted = !el.muted; sync(); });
    el.addEventListener('play', sync);
    el.addEventListener('pause', sync);
    sync();
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { load(); if (!userPaused) el.play().catch(() => {}); }
          else if (loaded) el.pause();
        });
      }, { threshold: 0.15 });
      obs.observe(el);
    } else { load(); }
  }
</script>
