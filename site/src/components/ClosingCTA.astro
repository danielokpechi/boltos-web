---
// The single, standardized closing CTA used across the site.
// Copy taken from the live boltos.ai homepage.
import { routes } from '../data/nav.js';
---
<section class="ccta">
  <div class="ccta-grid" aria-hidden="true"></div>
  <div class="ccta-glow" aria-hidden="true"></div>
  <div class="ccta-inner">
    <h2>Stop leaving money on the table. <span class="hl">Start engaging your audience today.</span></h2>
    <p>Join over 50 media brands already using our tools to transform passive viewers into active, valuable audience members.</p>
    <div class="ccta-actions"><a href={routes.bookDemo} class="ccta-btn">Book a Demo</a></div>
  </div>
</section>

<style>
  .ccta { position: relative; overflow: hidden; border-top: 1px dashed var(--hairline-dashed); padding: clamp(64px, 8vw, 128px) clamp(24px, 6vw, 80px); text-align: center; background: linear-gradient(180deg, #15171B, #0C0A12); }
  .ccta-grid { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(90deg, #1D2026 1px, transparent 1px), linear-gradient(#1D2026 1px, transparent 1px); background-size: 96px 96px; opacity: 0.45; }
  .ccta-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(640px 340px at 50% 108%, rgba(123,47,226,0.22), transparent 68%), radial-gradient(420px 260px at 14% 8%, rgba(53,199,223,0.14), transparent 72%); }
  .ccta-inner { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .ccta-inner h2 { margin: 0; font-family: var(--font-display); font-size: clamp(28px, 4.4vw, 60px); line-height: 1.04; font-weight: 500; letter-spacing: -0.03em; max-width: 900px; }
  .ccta-inner p { margin: 0; font-size: 16px; line-height: 26px; color: var(--text-muted); max-width: 620px; }
  .ccta-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .ccta-btn { font-size: 16px; line-height: 24px; font-weight: 600; color: var(--ink); background: var(--snow); padding: 15px 30px; border-radius: 100px; }
  .ccta-btn:hover { color: var(--snow); background: var(--ultra-violet); }
</style>
