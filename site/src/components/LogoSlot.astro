---
// A client/partner logo. Resolves the real file by name (own aspect ratio,
// never a uniform box). Because the supplied logos are single-version and the
// site has both dark and light grounds, real logos are tinted monochrome to the
// ground (white on dark, ink on light) so every one stays legible. Falls back to
// a correctly-proportioned horizontal placeholder when no file exists yet.
import { logoFor, logoKeepColor } from '../data/partnerLogos.js';
interface Props {
  name: string;
  src?: string | null;
  h?: number;        // rendered height in px
  onLight?: boolean; // ground is light → tint the logo dark
  class?: string;
}
const { name, src, h = 34, onLight = false, class: className } = Astro.props;
const resolved = src ?? logoFor(name);
// Full-colour badge logos keep their own colours (no monochrome tint).
const keepColor = logoKeepColor(name);
---
{resolved ? (
  <img
    src={resolved}
    alt={name}
    class:list={['logo-real', className]}
    style={keepColor
      ? `height:${h}px; width:auto; filter:none; opacity:1;`
      : `height:${h}px; width:auto; filter:${onLight ? 'brightness(0)' : 'brightness(0) invert(1)'}; opacity:${onLight ? 0.82 : 0.9};`}
  />
) : (
  <span
    class:list={['logo-slot', { 'on-light': onLight }, className]}
    data-logo-slot={name}
    role="img"
    aria-label={name}
    style={`height:${h}px;`}
  >{name}</span>
)}

<style>
  /* Tint (or full-colour, for badge logos) is applied inline per instance so
     it always wins over the cascade. */
  .logo-real { display: block; }

  .logo-slot {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0 14px; min-width: 88px; box-sizing: border-box;
    border: 1px dashed rgba(198,171,245,0.45); border-radius: 8px;
    font-family: var(--font-body); font-size: 13px; font-weight: 600;
    letter-spacing: 0.01em; white-space: nowrap;
    color: var(--text-soft); background: rgba(123,47,226,0.06);
  }
  .logo-slot.on-light { border-color: rgba(123,47,226,0.4); color: var(--ink-2); background: rgba(123,47,226,0.05); }
</style>
