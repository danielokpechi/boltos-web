---
// One consistent geometric line-icon set used across the site.
// Style: viewBox 0 0 24 24, no fill, round caps + joins, minimal detail.
// Renders inside a subtle violet tile by default so every card matches.
interface Props {
  name: string;
  tile?: boolean;
  size?: number;   // tile size in px
  class?: string;
}
const { name, tile = true, size = 48, class: className } = Astro.props;

// Each glyph is raw SVG markup (paths/circles) in a 24x24 box.
const glyphs: Record<string, string> = {
  chat: '<path d="M20 14a2 2 0 0 1-2 2H9l-4 3V6a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2z"/>',
  shop: '<path d="M6 8h12l-1 11a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>',
  read: '<path d="M12 6C10.5 4.8 8.5 4.5 5 5v13c3.5-.5 5.5-.2 7 1 1.5-1.2 3.5-1.5 7-1V5c-3.5-.5-5.5-.2-7 1z"/><path d="M12 6v13"/>',
  ai: '<path d="M12 3.5l1.6 4.9 4.9 1.6-4.9 1.6L12 16.5l-1.6-4.9L5.5 10l4.9-1.6z"/><path d="M18 15l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/>',
  rewards: '<rect x="4" y="9" width="16" height="11" rx="1.5"/><path d="M4 13h16M12 9v11"/><path d="M12 9c-3.2 0-4.2-5-.2-3 4-2 3.2 3-.2 3z"/>',
  analytics: '<path d="M5 20V11M12 20V4M19 20v-6"/>',
  integration: '<path d="M9.5 14.5l5-5"/><path d="M8 12.5l-2 2a3 3 0 0 0 4.2 4.2l2-2"/><path d="M16 11.5l2-2a3 3 0 0 0-4.2-4.2l-2 2"/>',
  intelligence: '<path d="M3 12h4l2.5-6L13 18l2.5-6H21"/>',
  shield: '<path d="M12 3.5l7 2.8v5.2c0 4-2.9 7-7 8.5-4.1-1.5-7-4.5-7-8.5V6.3z"/>',
  clock: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4.2l3 1.8"/>',
  external: '<path d="M13 5H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"/><path d="M14 4h6v6"/><path d="M20 4l-8.5 8.5"/>',
  tag: '<path d="M4.5 11.5l7-7H18a1.5 1.5 0 0 1 1.5 1.5v6.5l-7 7z"/><circle cx="15.5" cy="8.5" r="1.3"/>',
  data: '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/><path d="M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3"/>',
  megaphone: '<path d="M4 10v4l11 5V5z"/><path d="M15 8.5a3.5 3.5 0 0 1 0 7"/>',
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.5"/>',
  revenue: '<path d="M4 16.5l5.5-5.5 3 3L20 6.5"/><path d="M15 6.5h5v5"/>',
  layers: '<path d="M12 4l8 4-8 4-8-4z"/><path d="M4 12l8 4 8-4"/><path d="M4 16l8 4 8-4"/>',
  'shield-check': '<path d="M12 3.5l7 2.8v5.2c0 4-2.9 7-7 8.5-4.1-1.5-7-4.5-7-8.5V6.3z"/><path d="M9 12l2.2 2.2L15.5 10"/>',
  lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  key: '<circle cx="8" cy="8" r="4"/><path d="M11 11l8 8"/><path d="M16 16l2-2"/>',
  broadcast: '<circle cx="12" cy="12" r="1.8"/><path d="M8 8a5.5 5.5 0 0 0 0 8M16 8a5.5 5.5 0 0 1 0 8"/><path d="M5.5 5.5a9 9 0 0 0 0 13M18.5 5.5a9 9 0 0 1 0 13"/>',
  globe: '<circle cx="12" cy="12" r="8"/><path d="M4 12h16"/><path d="M12 4c2.8 2.2 2.8 13.8 0 16M12 4c-2.8 2.2-2.8 13.8 0 16"/>',
  users: '<circle cx="9" cy="8" r="3"/><path d="M4 20a5 5 0 0 1 10 0"/><path d="M15.5 5.5a3 3 0 0 1 0 6"/><path d="M17 20a5 5 0 0 0-2.2-4.1"/>',
  rocket: '<path d="M12 3.5c2.8 2 4.5 5.5 4.5 10L12 17l-4.5-3.5c0-4.5 1.7-8 4.5-10z"/><circle cx="12" cy="10" r="1.6"/><path d="M9 16.5l-3 4 4-2M15 16.5l3 4-4-2"/>',
  code: '<path d="M8.5 8L4.5 12l4 4M15.5 8l4 4-4 4M13.5 6l-3 12"/>',
  spark: '<path d="M12 4v5M12 15v5M4 12h5M15 12h5M6.5 6.5l3 3M14.5 14.5l3 3M17.5 6.5l-3 3M9.5 14.5l-3 3"/>',
  puzzle: '<path d="M9 5h6v3a2 2 0 1 0 4 0h1v6h-3a2 2 0 1 0 0 4v1H5v-6h1a2 2 0 1 0 0-4H5V5z"/>',
};
const glyph = glyphs[name] || glyphs.spark;
---
{tile ? (
  <span class:list={['bicon-tile', className]} style={`width:${size}px; height:${size}px;`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width={Math.round(size * 0.58)} height={Math.round(size * 0.58)} aria-hidden="true" set:html={glyph}></svg>
  </span>
) : (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width={size} height={size} aria-hidden="true" set:html={glyph}></svg>
)}

<style>
  .bicon-tile { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 13px; background: rgba(123,47,226,0.12); border: 1px solid rgba(123,47,226,0.24); color: var(--ultra-violet); }
</style>
