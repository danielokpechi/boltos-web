---
// Closing CTA: light gradient card with a bleeding player mock.
// Shared by /solutions/immersive-platform/ and /solutions/custom-bolt/.
import ParticleWave from './ParticleWave.astro';
import { routes } from '../data/nav.js';

interface Props { line1: string; line2: string; }
const { line1, line2 } = Astro.props;
const POSTER = '/assets/photos/broadcast-still.web.jpg';
---
<div class="pcta">
  <div class="pcta-wave" aria-hidden="true"><ParticleWave /></div>
  <div class="pcta-glow" aria-hidden="true"></div>
  <div class="pcta-card">
    <div class="pcta-copy">
      <h2>{line1}<br />{line2}</h2>
      <a href={routes.bookDemo} class="pcta-btn">Book a Demo</a>
    </div>
    <div class="pcta-mockwrap">
      <div class="pcta-mock">
        <img src={POSTER} alt="Player still" />
        <span class="pcta-mock-scrim"></span>
        <span class="pcta-play-ring"></span>
        <span class="pcta-play-tri"></span>
        <div class="pcta-mock-foot">
          <span class="pcta-mock-name">Football TV</span>
          <span class="pcta-mock-age">14+</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .pcta { position: relative; overflow: hidden; background: var(--page); padding: clamp(52px, 6vw, 88px) clamp(20px, 4vw, 60px); }
  .pcta-wave { position: absolute; left: 0; right: 0; bottom: -22%; width: 100%; height: min(26vw, 280px); z-index: 0; opacity: 0.30; pointer-events: none; mask-image: radial-gradient(closest-side, #000, transparent); -webkit-mask-image: radial-gradient(closest-side, #000, transparent); }
  .pcta-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(700px 380px at 50% 100%, rgba(123,47,226,0.26), transparent 74%); }
  .pcta-card { position: relative; z-index: 2; max-width: 1240px; margin: 0 auto; background: linear-gradient(115deg, #F7F7F5 0%, #F1EEFA 54%, #E4D9FA 100%); border-radius: 24px; overflow: hidden; box-shadow: 0 40px 110px rgba(0,0,0,0.55); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); align-items: center; text-align: left; }
  .pcta-copy { min-width: 0; padding: clamp(40px, 5.5vw, 84px) clamp(26px, 3.6vw, 60px); }
  .pcta-copy h2 { margin: 0 0 clamp(26px, 3vw, 40px); font-family: var(--font-display); font-size: clamp(30px, 4vw, 54px); line-height: 1.04; font-weight: 800; letter-spacing: -0.034em; color: var(--ink); text-wrap: pretty; }
  .pcta-btn { display: inline-block; font-size: 16px; line-height: 24px; font-weight: 600; background: var(--night); color: var(--snow); padding: 15px 32px; border-radius: 10px; }
  .pcta-btn:hover { color: var(--snow); background: var(--ultra-violet); }
  .pcta-mockwrap { position: relative; min-width: 0; align-self: center; margin: clamp(28px, 4vw, 64px) calc(clamp(26px, 3.6vw, 60px) * -1) clamp(28px, 4vw, 64px) 0; }
  .pcta-mock { position: relative; width: calc(100% + clamp(30px, 5vw, 90px)); aspect-ratio: 16 / 10; border: 5px solid var(--ultra-violet); border-right: none; border-radius: 12px 0 0 12px; overflow: hidden; box-shadow: 0 28px 70px rgba(16,16,20,0.35); }
  .pcta-mock img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .pcta-mock-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11,11,15,0.05), rgba(11,11,15,0.45)); }
  .pcta-play-ring { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: clamp(44px, 4.4vw, 62px); height: clamp(44px, 4.4vw, 62px); border-radius: 50%; background: rgba(123,47,226,0.72); border: 1px solid rgba(247,247,245,0.6); backdrop-filter: blur(4px); }
  .pcta-play-tri { position: absolute; left: 50%; top: 50%; transform: translate(-40%, -50%); border-left: clamp(11px, 1.2vw, 15px) solid #F7F7F5; border-top: clamp(7px, 0.8vw, 10px) solid transparent; border-bottom: clamp(7px, 0.8vw, 10px) solid transparent; }
  .pcta-mock-foot { position: absolute; left: 0; right: 0; bottom: 0; padding: clamp(12px, 1.4vw, 18px); display: flex; align-items: center; gap: 10px; }
  .pcta-mock-name { font-family: var(--font-display); font-size: clamp(14px, 1.5vw, 19px); font-weight: 800; letter-spacing: -0.02em; color: var(--snow); }
  .pcta-mock-age { font-family: var(--font-mono); font-size: 10px; color: var(--snow); border: 1px solid rgba(247,247,245,0.4); border-radius: 5px; padding: 3px 7px; }

  @media (max-width: 760px) {
    .pcta-card { grid-template-columns: 1fr; }
    .pcta-mockwrap { margin-right: 0; }
    .pcta-mock { width: 100%; border-right: 5px solid var(--ultra-violet); border-radius: 12px; }
  }
</style>
