---
import Base from '../layouts/Base.astro';
import ParticleWave from '../components/ParticleWave.astro';
import Roadmap from '../components/Roadmap.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import Faq from '../components/Faq.astro';
import LogoSlot from '../components/LogoSlot.astro';
import { routes, external } from '../data/nav.js';

// src is the official horizontal logo (own aspect ratio); null → placeholder
// until the partner's file is supplied. Bolt+ uses our own delivered SVG.
const partners = [
  { name: 'Hisense', src: null },
  { name: 'Bloomberg', src: null },
  { name: 'OneFootball', src: null },
  { name: 'Dubai 24H Series', src: null },
  { name: 'Bolt+', src: null },
  { name: 'VIDAA', src: null },
  { name: 'Olympusat', src: null },
  { name: 'TheSoul Publishing', src: null },
];

const products = [
  {
    name: 'Bolt+', logo: '/assets/logo/BoltPlus_Primary_RGB.svg', tag: 'BoltOS-operated', kind: 'Interactive Distribution Platform', variant: 'plus',
    copy: 'BoltOS-operated platform for globally accessible content distribution, interactive audience experiences and monetisation.',
    points: ['Streaming & content delivery', 'Content availability across screens', 'Interactive audience experience', 'Advertising monetisation', 'Audience intelligence'],
    cta: { href: external.boltplus, label: 'Visit boltplus.tv ↗', external: true },
  },
  {
    name: 'Bolt One', logo: '/assets/logo/BoltOne_Primary.png', tag: 'Customer-operated', kind: 'Enterprise Audience Platform', variant: 'one',
    copy: "Technology platform deployed in customers' own digital environments to build, engage, understand and monetise audiences.",
    points: ['Core: digital experience infrastructure', 'Connect: audience engagement & monetisation', 'Intelligence: audience intelligence & AI'],
    cta: { href: routes.boltOne, label: 'Explore Bolt One →' },
  },
];

const ecosystem = [
  { step: 'Distribute', copy: 'Make content globally accessible', icon: '<rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>' },
  { step: 'Engage', copy: 'Create meaningful interactions', icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
  { step: 'Understand', copy: 'Generate first-party audience intelligence', icon: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/>' },
  { step: 'Activate', copy: 'Personalise and automate', icon: '<path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"/>' },
  { step: 'Monetise', copy: 'Maximise audience economic value', icon: '<circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/>' },
];

const modules = [
  { num: '01', name: 'Chat', copy: 'Real-time conversations, quizzes and ad banners, keep viewers glued to their screens for 3x longer. When audiences interact, they stay engaged.' },
  { num: '02', name: 'Commerce', copy: 'Take advantage of personalized shopping integration. Host your merch store at the heart of where your community is engaging, bumping up your conversion numbers.' },
  { num: '03', name: 'Read', copy: 'For brands with premium reading material, why not organize your thought pieces to complement your content? Increasing click-throughs and ensuring your audience is interacting with your wider ecosystem.' },
  { num: '04', name: 'Rewards', copy: "Host giveaways, competitions or sponsored campaigns in the panel itself. Don't just make it a social experience, make it an event. Use this module for building retention and for giving back to your community." },
];

const intelligenceModules = [
  { num: 'IRIS', logo: '/assets/logo/IRIS_Secondary.svg', name: 'AI-driven interaction & intelligence', href: `${routes.intelligence}#iris`, copy: 'Turn your panel into a two-way interaction. Our AI companion is there to engage with your audience, learn from them and deliver an even more curated panel experience. All while supplying you with the data to make smarter decisions around your content and advertising.' },
  { num: 'PULSE', logo: '/assets/logo/Pulse_Secondary.png', name: 'Audience intelligence & activation', href: `${routes.intelligence}#pulse`, copy: 'Real-time analytics showing engagement metrics, sentiment analysis, demographic breakdown, and behavior patterns as they happen. Understand what resonates, optimize content on the fly, and make data-driven decisions during the broadcast, not days later.' },
];

const stats = [
  { value: '3×', label: 'Longer watch time', color: '#F7F7F5' },
  { value: '1M+', label: 'Interactions served', color: '#C6ABF5' },
  { value: '800+', label: 'Media brands', color: '#35C7DF' },
];

const pillars = [
  { icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 1 1 0 10h-2"/><line x1="8" x2="16" y1="12" y2="12"/></svg>', title: 'Seamless Integration', copy: 'Mounted on the player you already own, or run it your way. BoltOS-operated on Bolt+, or customer-operated on Bolt One.' },
  { icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>', title: 'Increase Audience Value', copy: 'Maximise engagement, data and monetisation potential.' },
  { icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>', title: 'Scalable & Secure', copy: 'Enterprise-grade infrastructure built for scale.' },
  { icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>', title: 'Future-Ready', copy: 'AI-powered intelligence layer driving continuous improvement.' },
];

const cases = [
  { name: 'Hisense', tag: 'Smart TV', quote: 'We view our partnership with BoltOS as strategic and valuable for building and maintaining viewer loyalty.', person: 'Jerry Liu · VP, Hisense International', stat: '14M TVs · 80 countries' },
  { name: 'VIDAA', tag: 'TV OS', quote: "A powerful example of social TV, enabling real interaction on live and VOD content. They're set for great success.", person: 'Guy Edri · CEO, VIDAA International', stat: "World's leading TV OS" },
  { name: '24H Series', tag: 'Motorsport', quote: 'Interactive features, moderated feeds and car POV feeds, the highlight of the entire Hankook Endurance Season.', person: 'Erik Naeser · Sports Advantage', stat: '150K interactions' },
];

const faqs = [
  ['Do I need technical expertise to use BoltOS products?', 'Not at all. Our products are designed for media teams, not developers. The control panel designed to manage them is also intuitive, and we provide guidance and workshops to educate your teams on best practices.'],
  ['How long does setup take?', 'Setup once the brief is finalized can take anywhere from two to four weeks, depending on our workload at the time. However, we always endeavor to deliver in the shortest time frame possible while not compromising on quality.'],
  ["What if my broadcasting platform isn't listed in your integrations?", "We add new integrations regularly based on customer demand. If your platform isn't currently supported, contact our team. We can often create custom integrations or use other means of connection."],
  ['Can viewers access interactive features on mobile devices?', 'Yes. All our interactive features are fully optimized for mobile, tablet, and desktop. Your audience can participate regardless of device.'],
  ['How many concurrent viewers can your system handle?', "Our infrastructure auto-scales to handle unlimited concurrent users. We've successfully supported broadcasts with 250,000+ simultaneous viewers without performance degradation."],
  ['Can I customize the look and feel to match my brand?', 'Absolutely. You have complete control over colors, fonts, layouts, and branding. We offer templates for quick setup, or you can create fully custom designs. Enterprise plans include white-label options with custom domains.'],
  ['How do you handle data privacy and security?', "We're GDPR compliant and use end-to-end encryption. Your data and your audience's data are protected with enterprise-grade security."],
].map(([q, a], i) => ({ q, a, num: String(i + 1).padStart(2, '0') }));
---
<Base title="BoltOS, Media Technology Group" description="BoltOS builds the technology that enables media companies to distribute content, engage, understand and monetise digital audiences.">
  <div class="hp">
    <!-- 01 HERO -->
    <header class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-top">
        <div class="hero-badge"><span class="hero-badge-emoji" aria-hidden="true">🚀</span>New: AI-Powered Analytics</div>
        <h1 class="hero-h1">The Enterprise Operating Infrastructure for<br> <span class="hl">Engagement-Driven Media</span></h1>
        <p class="hero-sub">Building the technology that enables media companies to distribute content, engage, understand and monetise digital audiences.</p>
        <div class="hero-cta"><a href={routes.bookDemo} class="btn-snow">Take a Tour</a></div>
      </div>
      <div class="hero-player-wrap">
        <div class="hero-grid-v" aria-hidden="true"></div>
        <div class="hero-wave" aria-hidden="true"><ParticleWave /></div>
        <div class="hero-player">
          <div class="hero-video">
            <a href="https://youtu.be/AByOQDvWeIE" target="_blank" rel="noopener noreferrer" class="hero-video-fallback">
              <img src="/assets/photos/broadcast-still.web.jpg" alt="BoltOS platform video" class="hero-video-poster" />
              <span class="hero-video-scrim"></span>
              <span class="hero-video-btn">▶ Watch the platform video</span>
            </a>
            <iframe
              src="https://www.youtube-nocookie.com/embed/AByOQDvWeIE?rel=0&amp;modestbranding=1&amp;playsinline=1&amp;autoplay=1&amp;mute=1"
              title="BoltOS platform video"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
              class="hero-video-frame"
            ></iframe>
          </div>
          <div class="hero-player-foot">
            <div>Panel mounted on your player</div>
            <div class="mono">latency 84ms</div>
          </div>
        </div>
      </div>
    </header>

    <!-- 02 TRUSTED BY -->
    <div class="trusted">
      <div class="trusted-track">
        {[...partners, ...partners].map((p) => (
          <span class="trusted-item"><LogoSlot name={p.name} src={p.src} h={30} /></span>
        ))}
      </div>
    </div>

    <!-- 03 PRODUCTS -->
    <section id="products" class="models">
      <div class="models-head">
        <div class="models-eyebrow">Our products</div>
        <h2>Two complementary models. <span class="hl">One mission.</span></h2>
        <p>Build stronger audiences. Drive deeper engagement. Deliver greater returns.</p>
      </div>
      <div class="models-grid">
        {products.map((p) => (
          <article class={`model model-${p.variant}`}>
            <div class="model-tag">{p.tag}</div>
            <h3>{p.logo ? <img src={p.logo} alt={p.name} class="model-logo" /> : p.name}</h3>
            <div class="model-kind">{p.kind}</div>
            <p>{p.copy}</p>
            <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
            <a href={p.cta.href} class="model-cta" {...(p.cta.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{p.cta.label}</a>
          </article>
        ))}
      </div>
    </section>

    <!-- 04 ONE ECOSYSTEM -->
    <section id="ecosystem" class="eco">
      <div class="eco-head">
        <div class="eco-eyebrow">One ecosystem</div>
        <h2>From first view to lasting value</h2>
      </div>
      <ol class="eco-steps">
        {ecosystem.map((e) => (
          <li class="eco-step">
            <span class="eco-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={e.icon} /></span>
            <h3>{e.step}</h3>
            <p>{e.copy}</p>
          </li>
        ))}
      </ol>
      <div class="eco-foot">Shared technology · Data · AI · Monetisation capabilities</div>
    </section>

    <!-- 05 CONNECT -->
    <section id="suite" class="suite">
      <div class="suite-grid" aria-hidden="true"></div>
      <div class="suite-glow" aria-hidden="true"></div>
      <div class="suite-head">
        <img src="/assets/icons/layers/engage.png" alt="" class="suite-icon" />
        <div class="suite-eyebrow">Solutions · Engage</div>
        <h2 class="suite-h2">Connect</h2>
        <p class="suite-sub">Interactive features and monetisation tools that turn passive viewers into active, loyal and valuable audiences.</p>
        <a href={routes.connect} class="suite-link">Explore Connect →</a>
      </div>
      <div class="suite-modules">
        {modules.map((m) => (
          <div class="module">
            <div class="module-num">{m.num}</div>
            <h3>{m.name}</h3>
            <p>{m.copy}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 06 INTELLIGENCE -->
    <section id="intelligence" class="suite">
      <div class="suite-grid" aria-hidden="true"></div>
      <div class="suite-glow" aria-hidden="true"></div>
      <div class="suite-head">
        <img src="/assets/icons/layers/intelligence.png" alt="" class="suite-icon" />
        <div class="suite-eyebrow">Solutions · Audience Intelligence &amp; AI</div>
        <h2 class="suite-h2">Intelligence</h2>
        <p class="suite-sub">AI-powered intelligence to understand audiences, generate insights and drive monetisation.</p>
        <a href={routes.intelligence} class="suite-link">Explore Intelligence →</a>
      </div>
      <div class="suite-modules">
        {intelligenceModules.map((m) => (
          <a href={m.href} class="module module-link">
            <img src={m.logo} alt={m.num} class={`module-logo module-logo-${m.num.toLowerCase()}`} />
            <h3>{m.name}</h3>
            <p>{m.copy}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- 04 STATS -->
    <section class="stats">
      <div class="stats-glow" aria-hidden="true"></div>
      <div class="stats-wave" aria-hidden="true"><ParticleWave running={true} /></div>
      <div class="stats-head">
        <h2>Real tools. Real results.</h2>
        <p>In a crowded world of tech, BoltOS has exceeded expectations time and time again</p>
      </div>
      <div class="stats-row">
        {stats.map((s) => (
          <div class="stat">
            <div class="stat-value" style={`color:${s.color};`}>{s.value}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- 05 WHY BOLTOS -->
    <section id="why" class="why">
      <div class="why-grid" aria-hidden="true"></div>
      <div class="why-head">
        <div class="why-eyebrow"><span class="dot dot-uv"></span>Why BoltOS</div>
        <h2>Why modern digital platforms need BoltOS</h2>
        <p>Most content keeps audiences passive. They watch, but they never participate, never buy, never truly engage. Every broadcast without interaction is money left on the table.</p>
      </div>
      <div class="why-pillars">
        {pillars.map((p) => (
          <div class="pillar">
            <span class="pillar-icon" set:html={p.icon} />
            <h3>{p.title}</h3>
            <p>{p.copy}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 06 ROADMAP -->
    <Roadmap />

    <!-- 07 TESTIMONIALS -->
    <section id="partners" class="tst">
      <div class="tst-glow" aria-hidden="true"></div>
      <div class="tst-head">
        <h2>In their own words</h2>
        <p>Broadcasters, TV platforms and rights holders running live audiences on BoltOS.</p>
      </div>
      <div class="tst-marquee">
        <div class="tst-track">
          {[...cases, ...cases].map((c) => (
            <div class="tst-card">
              <div class="tst-card-head">
                <LogoSlot name={c.name} h={26} />
                <span class="tst-tag">{c.tag}</span>
              </div>
              <p class="tst-quote">“{c.quote}”</p>
              <div class="tst-card-foot">
                <span>{c.person}</span><span class="tst-stat">{c.stat}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 08 FAQ -->
    <Faq items={faqs} />

    <!-- 09 CLOSING CTA (standardized) -->
    <ClosingCTA />
  </div>
</Base>

<style>
  .hp { position: relative; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--sky-aqua); }
  .dot-uv { width: 7px; height: 7px; background: var(--ultra-violet); }
  .mono { font-family: var(--font-mono); }
  .uv { color: var(--ultra-violet); }
  .btn-snow { font-size: 16px; line-height: 24px; font-weight: 600; color: var(--ink); background: var(--snow); padding: 15px 30px; border-radius: 100px; }
  .btn-snow:hover { color: var(--snow); background: var(--ultra-violet); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }

  /* HERO */
  .hero { position: relative; overflow: hidden; padding: clamp(48px, 6vw, 88px) 0 0; text-align: center; }
  .hero-grid { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(90deg, #1D2026 1px, transparent 1px), linear-gradient(#1D2026 1px, transparent 1px); background-size: 96px 96px; opacity: 0.5; }
  .hero-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(700px 340px at 50% 12%, rgba(123,47,226,0.10), transparent 70%); }
  .hero-top { position: relative; padding: 0 clamp(24px, 6vw, 80px); display: flex; flex-direction: column; align-items: center; gap: 22px; }
  .hero-badge { display: flex; align-items: center; gap: 10px; border: 1px solid var(--hairline-2); background: var(--night-2); border-radius: 100px; padding: 7px 16px; font-size: 13px; line-height: 19px; color: var(--text-soft); }
  .hero-h1 { margin: 0; font-family: var(--font-display); font-size: clamp(34px, 5.6vw, 76px); line-height: 1.02; font-weight: 500; letter-spacing: -0.032em; max-width: 940px; }
  .hero-sub { margin: 0; font-size: clamp(16px, 1.7vw, 19px); line-height: 1.6; color: var(--text-muted); max-width: 600px; }
  .hero-player-wrap { position: relative; margin-top: clamp(20px, 2.6vw, 32px); border-bottom: 1px dashed var(--hairline-dashed); padding: 0 clamp(24px, 6vw, 80px) clamp(32px, 5vw, 64px); overflow: hidden; }
  .hero-grid-v { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(90deg, #1D2026 1px, transparent 1px); background-size: 96px 96px; opacity: 0.6; }
  .hero-wave { position: absolute; left: 0; right: 0; bottom: -60px; height: 300px; opacity: 0.4; pointer-events: none; }
  .hero-player { position: relative; width: 100%; max-width: 900px; margin: 0 auto; background: var(--night-2); border: 1px solid var(--hairline-2); border-radius: 16px; box-shadow: 0 28px 60px rgba(0,0,0,0.55); overflow: hidden; }
  .hero-video { position: relative; aspect-ratio: 16 / 9; background: #0B0B0F; }
  .hero-video-fallback { position: absolute; inset: 0; z-index: 0; display: flex; align-items: center; justify-content: center; }
  .hero-video-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-video-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11,11,15,0.35), rgba(11,11,15,0.65)); }
  .hero-video-btn { position: relative; white-space: nowrap; display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; color: var(--ink); background: var(--snow); padding: 12px 22px; border-radius: 100px; }
  .hero-video-frame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }
  .hero-player-foot { padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; gap: 12px; border-top: 1px solid var(--hairline); text-align: left; }
  .hero-player-foot > div:first-child { font-size: 13px; line-height: 19px; color: var(--text-muted); }
  .hero-player-foot .mono { font-size: 11px; color: var(--text-dim); }

  /* TRUSTED BY */
  .trusted { position: relative; overflow: hidden; padding: clamp(28px, 4vw, 48px) 0; border-bottom: 1px dashed var(--hairline-dashed); background: linear-gradient(180deg, rgba(123,47,226,0.05), rgba(251,251,250,0)); }
  .trusted-track { display: flex; gap: 64px; width: max-content; animation: v5marquee 38s linear infinite; align-items: center; padding-top: 8px; font-family: var(--font-display); font-size: clamp(16px, 1.8vw, 22px); font-weight: 700; color: var(--text-dim); }
  .trusted-item { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; height: clamp(40px, 4.4vw, 56px); padding: 0 4px; }
  .trusted-logo { display: block; height: 100%; aspect-ratio: 1 / 1; border-radius: 12px; object-fit: cover; }
  .trusted-text { white-space: nowrap; }

  /* PRODUCT SUITE */
  .suite { position: relative; overflow: hidden; background: var(--snow); color: var(--ink); padding: clamp(56px, 7vw, 104px) clamp(24px, 6vw, 80px); }
  .suite-grid { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(90deg, var(--snow-line) 1px, transparent 1px); background-size: 96px 96px; opacity: 0.4; }
  .suite-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(560px 320px at 88% 76%, rgba(53,199,223,0.10), transparent 70%); }
  .suite-head { position: relative; display: flex; flex-direction: column; gap: 12px; max-width: 640px; }
  .suite-eyebrow { font-size: 14px; line-height: 21px; color: var(--ink-muted); }
  .suite-h2 { margin: 0; font-family: var(--font-display); font-size: clamp(28px, 3.6vw, 46px); line-height: 1.08; font-weight: 700; letter-spacing: -0.025em; }
  .suite-sub { margin: 0; font-size: 16px; line-height: 26px; color: var(--ink-muted); }
  .suite-modules { position: relative; margin-top: clamp(32px, 4vw, 56px); border: 1px solid var(--snow-line); border-radius: 14px; background: rgba(255,255,255,0.88); backdrop-filter: blur(6px); box-shadow: 0 20px 50px rgba(16,16,20,0.08); display: flex; flex-wrap: wrap; overflow: hidden; }
  .module { flex: 1 1 260px; min-width: 0; padding: 24px; box-shadow: inset -1px 0 0 var(--snow-line), inset 0 -1px 0 var(--snow-line); display: flex; flex-direction: column; gap: 10px; }
  .module:hover { background: rgba(123,47,226,0.10); }
