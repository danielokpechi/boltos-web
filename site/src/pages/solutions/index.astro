---
import Base from '../../layouts/Base.astro';
import ParticleWave from '../../components/ParticleWave.astro';
import Roadmap from '../../components/Roadmap.astro';
import { routes } from '../../data/nav.js';

const solutions = [
  { num: '01', name: 'Immersive Platform', copy: 'A revenue layer for your existing ecosystem', href: routes.immersive, accent: '#7B2FE2', offset: false },
  { num: '02', name: 'Custom Bolt+', copy: 'Own the distribution. Own the monetisation. Own the data.', href: routes.customBolt, accent: '#D62086', offset: true },
];

const faqs = [
  ['Do I need technical expertise to use BoltOS solutions?', 'Not at all. Our solutions are designed for media and entertainment teams with busy schedules. You get access to an intuitive and user-friendly control panel with all our solutions, and we provide guidance every step of the way during implementation and recommendation on the best practices as you start your journey with us.'],
  ['What do you need from us to get started?', "The exact requirements depend on the project. In most cases, we start with your brief, branding assets and intended use case. From there, we'll guide you through any additional materials or access we need."],
  ['How long does setup take?', 'Once the brief is finalised, setup typically takes between two to four weeks, depending on our workload at the time. However, we always aim to deliver as quickly as possible without compromising on quality.'],
  ['What analytics and audience insights do we receive?', 'The reporting available depends on the solution, integration and project requirements. We can work with you to determine which audience insights are most relevant to your objectives to set up your dashboard accordingly.'],
  ['Where can audiences access interactive features?', 'All our interactive features can be accessed from anywhere in the world and are fully optimised for mobile, tablet, and desktop. Your audience can participate regardless of device.'],
  ['Can I customise the look and feel of your solutions to match my brand?', 'Absolutely. You have full control over the colours, fonts, layouts, and branding. We offer templates for quick setup, or you can create fully bespoke designs.'],
  ["What's your uptime guarantee?", 'We maintain 99.9% uptime, supported by redundant infrastructure and continuous monitoring. Our status page provides real-time updates on system health.'],
  ['How do you handle data privacy and security?', "We're GDPR compliant and use end-to-end encryption. Your data and your audience's data are protected with enterprise-grade security."],
].map(([q, a]) => ({ q, a }));
---
<Base title="Solutions, BoltOS">
  <div class="sol">
    <header class="sol-hero">
      <div class="sol-hero-head">
        <div class="sol-eyebrow"><span class="sol-eyebrow-rule"></span><span>Solutions</span></div>
        <h1>Taking fan monetisation to the <span class="uv">next level</span></h1>
      </div>
      <div class="sol-cards">
        {solutions.map((s) => (
          <div class={`sol-card ${s.offset ? 'offset' : ''}`} style={`--accent:${s.accent};`}>
            <span class="sol-card-ghost">{s.num}</span>
            <span class="sol-card-bar"></span>
            <h2>{s.name}</h2>
            <p>{s.copy}</p>
            <a href={s.href} class="sol-card-link">Learn More →</a>
          </div>
        ))}
      </div>
    </header>

    <Roadmap />

    <section class="sol-faq">
      <div class="sol-faq-wave" aria-hidden="true"><ParticleWave /></div>
      <div class="sol-faq-inner">
        <h2>Frequently Asked Questions</h2>
        <div class="sol-faq-grid">
          {faqs.map((f) => (
            <div class="sol-faq-card">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .uv { color: var(--ultra-violet); }
  .sol { position: relative; }

  .sol-hero { position: relative; overflow: hidden; padding: clamp(56px, 7vw, 104px) clamp(24px, 6vw, 80px) clamp(56px, 7vw, 100px); }
  .sol-hero-head { position: relative; z-index: 2; max-width: 1000px; margin: 0 auto clamp(38px, 4.6vw, 68px); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .sol-eyebrow { display: flex; align-items: center; gap: 12px; }
  .sol-eyebrow-rule { width: 26px; height: 1px; background: var(--ultra-violet); }
  .sol-eyebrow span:last-child { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-lilac); }
  .sol-hero-head h1 { margin: 0; font-family: var(--font-display); font-size: clamp(32px, 4.6vw, 62px); line-height: 1.03; font-weight: 800; letter-spacing: -0.034em; max-width: 18ch; text-wrap: pretty; }

  .sol-cards { position: relative; max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: clamp(18px, 2.4vw, 32px); align-items: start; }
  .sol-card { position: relative; min-width: 0; background: var(--night-2); border: 1px solid var(--hairline); border-radius: 22px; padding: clamp(30px, 3.6vw, 52px); display: flex; flex-direction: column; gap: 18px; overflow: hidden; }
  .sol-card.offset { margin-top: clamp(0px, 4vw, 56px); }
  .sol-card:hover { border-color: var(--accent); }
  .sol-card-ghost { position: absolute; right: -14px; top: -28px; font-family: var(--font-display); font-size: clamp(96px, 12vw, 170px); line-height: 0.8; font-weight: 800; letter-spacing: -0.05em; color: rgba(247,247,245,0.05); }
  .sol-card-bar { position: relative; width: 44px; height: 3px; border-radius: 3px; background: var(--accent); }
  .sol-card h2 { position: relative; margin: 0; font-family: var(--font-display); font-size: clamp(26px, 3.4vw, 44px); line-height: 1.04; font-weight: 800; letter-spacing: -0.032em; }
  .sol-card p { position: relative; margin: 0; font-size: clamp(15px, 1.7vw, 19px); line-height: 1.55; color: var(--text-muted); max-width: 32ch; text-wrap: pretty; }
  .sol-card-link { position: relative; align-self: flex-start; margin-top: 8px; font-size: 15px; line-height: 22px; font-weight: 600; color: var(--snow); border-bottom: 1px solid var(--accent); padding-bottom: 4px; }
  .sol-card-link:hover { color: var(--accent); }

  .sol-faq { position: relative; overflow: hidden; background: var(--page); padding: clamp(56px, 7vw, 100px) clamp(24px, 6vw, 80px); border-top: 1px solid var(--hairline); }
  .sol-faq-wave { position: absolute; left: -8%; top: -26%; width: min(48vw, 540px); height: min(28vw, 300px); z-index: 0; opacity: 0.24; pointer-events: none; mask-image: radial-gradient(closest-side, #000, transparent); -webkit-mask-image: radial-gradient(closest-side, #000, transparent); }
  .sol-faq-inner { position: relative; z-index: 2; max-width: 1320px; margin: 0 auto; display: flex; flex-direction: column; gap: clamp(24px, 3vw, 40px); }
  .sol-faq-inner h2 { margin: 0; font-family: var(--font-display); font-size: clamp(28px, 3.4vw, 44px); line-height: 1.08; font-weight: 800; letter-spacing: -0.03em; }
  .sol-faq-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: clamp(14px, 1.8vw, 20px); }
  .sol-faq-card { background: var(--night-2); border: 1px solid var(--hairline); border-radius: 16px; padding: clamp(20px, 2.2vw, 28px); display: flex; flex-direction: column; gap: 10px; }
  .sol-faq-card:hover { border-color: rgba(123,47,226,0.5); }
  .sol-faq-card h3 { margin: 0; font-family: var(--font-display); font-size: 17px; line-height: 1.3; font-weight: 700; color: var(--snow); text-wrap: pretty; }
  .sol-faq-card p { margin: 0; font-size: 14px; line-height: 23px; color: var(--text-muted); text-wrap: pretty; }
</style>
