<script>
  // Voices carousel: swap portrait + quote card content on prev/next.
  const root = document.querySelector('[data-voices]') as HTMLElement | null;
  if (root) {
    let voices: { head: string; name: string; role: string; quote: string; src: string }[] = [];
    try { voices = JSON.parse(root.dataset.voices!); } catch { voices = []; }
    if (voices.length) {
      let i = 0;
      const img = document.getElementById('ab-voice-img') as HTMLImageElement;
      const head = document.getElementById('ab-voice-head')!;
      const name = document.getElementById('ab-voice-name')!;
      const role = document.getElementById('ab-voice-role')!;
      const quote = document.getElementById('ab-voice-quote')!;
      const count = document.getElementById('ab-voice-count')!;
      // Derive the folder from the first (server-rendered, base-correct) image so
      // swapped images resolve under any base path (root or /boltos-web/).
      const dir = (img.getAttribute('src') || '').replace(/[^/]+$/, '');
      const fileOf = (p: string) => p.split('/').pop() || p;
      const render = () => {
        const v = voices[((i % voices.length) + voices.length) % voices.length];
        img.src = dir + fileOf(v.src); img.alt = v.name;
        head.textContent = v.head; name.textContent = v.name; role.textContent = v.role;
        quote.textContent = v.quote;
        count.textContent = `${(((i % voices.length) + voices.length) % voices.length) + 1} / ${voices.length}`;
      };
      document.getElementById('ab-voice-prev')!.addEventListener('click', () => { i--; render(); });
      document.getElementById('ab-voice-next')!.addEventListener('click', () => { i++; render(); });
    }
  }
</script>
