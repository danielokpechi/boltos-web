---
import Base from '../../layouts/Base.astro';
import ParticleWave from '../../components/ParticleWave.astro';
import { articles, hrefFor, isExternal, keyFor } from '../../data/articles.js';
import { external, routes } from '../../data/nav.js';

export function getStaticPaths() {
  return articles
    .filter((a) => a.internal)
    .map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}

const { article } = Astro.props;
const related = articles.filter((a) => keyFor(a) !== keyFor(article)).slice(0, 6);

const socialCards = [
  { label: '@boltplus on X', tag: 'Announcements', href: external.x },
  { label: 'Discord', tag: 'Creator Community', href: external.discord },
  { label: 'LinkedIn', tag: 'Ecosystem Updates', href: external.linkedin },
  { label: 'Bolt+', tag: 'AMAs', href: external.boltplus },
];
---
<Base title={`${article.title}, BoltOS`} description={article.excerpt || `${article.title} — BoltOS Newsroom.`}>
  <article class="ar">
    <div class="ar-hero-glow" aria-hidden="true"></div>
    <div class="ar-wave" aria-hidden="true"><ParticleWave /></div>

    <header class="ar-head">
      <div class="ar-meta">
        <a href={routes.newsroom} class="ar-back">Newsroom</a>
        <span class="ar-meta-sep" aria-hidden="true">·</span>
        {article.categories.map((c) => <span class="ar-cat">{c}</span>)}
        <span class="ar-meta-sep" aria-hidden="true">·</span>
        <time class="ar-date">{article.date}</time>
      </div>
      <h1>{article.title}</h1>
      <div class="ar-byline">
        <span class="ar-avatar" aria-hidden="true">B</span>
        <span class="ar-byline-text">By <strong>{article.author}</strong></span>
      </div>
    </header>

    {article.image && (
      <figure class="ar-hero">
        <div class="ar-hero-frame"><img src={article.image} alt={article.heroCaption || article.title} /></div>
        {article.heroCaption && <figcaption>{article.heroCaption}</figcaption>}
      </figure>
    )}

    <div class="ar-body">
      {article.body.map((b) => (
        b.type === 'ul'
          ? <ul>{b.items.map((i) => <li set:html={i} />)}</ul>
          : b.type === 'quote'
            ? <blockquote set:html={b.html} />
            : <p set:html={b.html} />
      ))}
    </div>

    <!-- Related posts (no raw URLs, no comment counts) -->
    <section class="ar-related">
      <h2>More from the Newsroom</h2>
      <div class="ar-related-grid">
        {related.map((r) => (
          <a
            href={hrefFor(r)}
            {...(isExternal(r) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            class="ar-card"
          >
            <div class="ar-card-media"><img src={r.image} alt={r.title} /></div>
            <div class="ar-card-body">
              <span class="ar-card-date">{r.date}</span>
              <h3>{r.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Author card (deliberately not linked to any profile route) -->
    <section class="ar-author">
      <span class="ar-avatar lg" aria-hidden="true">B</span>
      <div class="ar-author-text">
        <div class="ar-author-name">{article.author}</div>
        <p>News and announcements from the BoltOS team.</p>
      </div>
    </section>

    <!-- Social -->
    <section class="ar-social">
      <div class="ar-social-head">
        <h2>Innovate. Inspire. Include.</h2>
      </div>
      <div class="ar-social-grid">
        {socialCards.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="ar-social-card">
            <span class="ar-social-tag">{s.tag}</span>
            <span class="ar-social-label">{s.label}</span>
            <span class="ar-social-arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </section>
  </article>
</Base>

<style>
  .ar { position: relative; overflow: hidden; padding: clamp(40px, 5vw, 80px) clamp(24px, 6vw, 80px) clamp(64px, 8vw, 120px); }
  .ar-hero-glow { position: absolute; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(900px 520px at 50% 0%, rgba(123,47,226,0.16), transparent 74%); }
  .ar-wave { position: absolute; right: -10%; top: -18%; width: min(48vw, 540px); height: min(28vw, 300px); z-index: 0; opacity: 0.24; pointer-events: none; mask-image: radial-gradient(closest-side, #000, transparent); -webkit-mask-image: radial-gradient(closest-side, #000, transparent); }

  .ar-avatar { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(140deg, #7B2FE2, #D62086); color: #FFFFFF; font-family: var(--font-display); font-weight: 800; font-size: 15px; flex: 0 0 auto; }
  .ar-avatar.lg { width: 48px; height: 48px; font-size: 20px; }

  .ar-head { position: relative; z-index: 2; max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; text-align: center; align-items: center; }
  .ar-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-dim); }
  .ar-back { color: var(--text-lilac); }
  .ar-back:hover { color: var(--snow); }
  .ar-meta-sep { color: var(--hairline-2); }
  .ar-cat { color: var(--text-lilac); background: rgba(123,47,226,0.12); border: 1px solid rgba(123,47,226,0.30); border-radius: 100px; padding: 4px 11px; }
  .ar-date { color: var(--text-dim); }
  .ar-head h1 { margin: 0; font-family: var(--font-display); font-size: clamp(28px, 4vw, 52px); line-height: 1.08; font-weight: 800; letter-spacing: -0.032em; max-width: 20ch; text-wrap: balance; }
  .ar-byline { display: flex; align-items: center; gap: 12px; }
  .ar-byline-text { font-size: 14px; line-height: 20px; color: var(--text-muted); }
  .ar-byline-text strong { color: var(--snow); font-weight: 600; }

  .ar-hero { position: relative; z-index: 2; max-width: 980px; margin: clamp(32px, 4vw, 56px) auto 0; }
  .ar-hero-frame { border-radius: 20px; overflow: hidden; border: 1px solid var(--hairline); background: var(--night-2); aspect-ratio: 16 / 9; }
  .ar-hero-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ar-hero figcaption { margin-top: 12px; text-align: center; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; color: var(--text-dim); }

  .ar-body { position: relative; z-index: 2; max-width: 720px; margin: clamp(36px, 4.4vw, 60px) auto 0; }
  .ar-body p { margin: 0 0 22px; font-size: clamp(16px, 1.7vw, 18px); line-height: 1.75; color: var(--text-soft); text-wrap: pretty; }
  .ar-body strong { color: var(--snow); font-weight: 600; }
  .ar-body blockquote { margin: 0 0 22px; padding: 4px 0 4px 22px; border-left: 3px solid var(--ultra-violet); font-family: var(--font-display); font-size: clamp(19px, 2.1vw, 24px); line-height: 1.4; font-weight: 700; letter-spacing: -0.018em; color: var(--snow); }
  .ar-body ul { margin: 0 0 22px; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .ar-body li { position: relative; padding-left: 26px; font-size: clamp(16px, 1.7vw, 18px); line-height: 1.7; color: var(--text-soft); text-wrap: pretty; }
  .ar-body li::before { content: ''; position: absolute; left: 4px; top: 12px; width: 7px; height: 7px; border-radius: 50%; background: linear-gradient(140deg, #7B2FE2, #D62086); }

  .ar-related { position: relative; z-index: 2; max-width: 1160px; margin: clamp(52px, 6vw, 88px) auto 0; padding-top: clamp(40px, 5vw, 64px); border-top: 1px solid var(--hairline); }
  .ar-related h2 { margin: 0 0 clamp(20px, 2.4vw, 28px); font-family: var(--font-display); font-size: clamp(22px, 2.8vw, 34px); line-height: 1.1; font-weight: 800; letter-spacing: -0.026em; }
  .ar-related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: clamp(14px, 1.8vw, 20px); }
  .ar-card { display: flex; flex-direction: column; background: var(--night-2); border: 1px solid var(--hairline); border-radius: 18px; overflow: hidden; }
  .ar-card:hover { border-color: rgba(123,47,226,0.55); background: #191B21; }
  .ar-card-media { position: relative; aspect-ratio: 16 / 10; background: var(--night); }
  .ar-card-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .ar-card-body { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px; }
  .ar-card-date { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-lilac); }
  .ar-card h3 { margin: 0; font-family: var(--font-display); font-size: 16px; line-height: 1.28; font-weight: 700; letter-spacing: -0.016em; color: var(--snow); text-wrap: pretty; }

  .ar-author { position: relative; z-index: 2; max-width: 720px; margin: clamp(40px, 5vw, 64px) auto 0; display: flex; align-items: center; gap: 16px; background: var(--night-2); border: 1px solid var(--hairline); border-radius: 18px; padding: 22px 24px; }
  .ar-author-name { font-family: var(--font-display); font-size: 17px; font-weight: 700; color: var(--snow); }
  .ar-author-text p { margin: 4px 0 0; font-size: 14px; line-height: 21px; color: var(--text-muted); }

  .ar-social { position: relative; z-index: 2; max-width: 1160px; margin: clamp(52px, 6vw, 88px) auto 0; }
  .ar-social-head { text-align: center; margin-bottom: clamp(24px, 3vw, 36px); }
  .ar-social-head h2 { margin: 0; font-family: var(--font-display); font-size: clamp(26px, 3.4vw, 44px); line-height: 1.06; font-weight: 800; letter-spacing: -0.03em; }
  .ar-social-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: clamp(14px, 1.8vw, 18px); }
  .ar-social-card { position: relative; display: flex; flex-direction: column; gap: 10px; min-height: 140px; background: linear-gradient(165deg, rgba(123,47,226,0.16), rgba(21,23,27,0.95) 60%); border: 1px solid var(--hairline); border-radius: 18px; padding: clamp(20px, 2.2vw, 26px); }
  .ar-social-card:hover { border-color: rgba(123,47,226,0.6); }
  .ar-social-tag { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-lilac); }
  .ar-social-label { font-family: var(--font-display); font-size: clamp(19px, 2.1vw, 24px); line-height: 1.16; font-weight: 800; letter-spacing: -0.02em; color: var(--snow); }
  .ar-social-arrow { margin-top: auto; font-size: 18px; color: var(--sky-aqua); }
</style>
